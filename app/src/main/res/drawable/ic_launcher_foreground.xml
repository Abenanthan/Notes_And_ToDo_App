<!-- Adaptive icon foreground: a note page with a tick. The launcher crops to a shape of
     its choosing, so everything important stays in the middle third of the 108dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- page -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M38,26 L70,26 A6,6 0 0 1 76,32 L76,76 A6,6 0 0 1 70,82 L38,82 A6,6 0 0 1 32,76 L32,32 A6,6 0 0 1 38,26 Z" />

    <!-- two ruled lines -->
    <path
        android:fillColor="#FFB8C2CC"
        android:pathData="M40,38 L68,38 L68,42 L40,42 Z" />
    <path
        android:fillColor="#FFB8C2CC"
        android:pathData="M40,47 L60,47 L60,51 L40,51 Z" />

    <!-- tick -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF2E7D32"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M41,66 L48,73 L68,53" />
</vector>
